<% layout("/layouts/boilerplate") %>

    <div class="row mt-5 justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <div class="card shadow-sm border-0 rounded-4 p-4">
                <div class="card-body">

                    <% if (statusCode===404) { %>
                        <div class="display-1 text-warning fw-bold mb-3">404</div>
                        <h2 class="card-title mb-3">Page Not Found</h2>
                        <p class="text-muted mb-4">
                            <%= message %>
                        </p>
                        <a href="/" class="btn btn-primary rounded-pill px-4">Back to All Listings</a>

                        <% } else if (statusCode===400) { %>
                            <div class="display-1 text-danger fw-bold mb-3">400</div>
                            <h2 class="card-title mb-3">Bad Request</h2>
                            <div class="alert alert-danger text-start mb-4">
                                <strong>Validation Error:</strong>
                                <%= message %>
                            </div>
                            <button onclick="history.back()" class="btn btn-outline-secondary rounded-pill px-4">Go Back
                                & Fix</button>

                            <% } else { %>
                                <div class="display-1 text-danger fw-bold mb-3">
                                    <%= statusCode %>
                                </div>
                                <h2 class="card-title mb-3">Something Went Wrong</h2>
                                <div class="alert alert-warning text-start mb-4">
                                    <code><%= message %></code>
                                </div>
                                <a href="/" class="btn btn-dark rounded-pill px-4">Return Home</a>
                                <% } %>

                </div>
            </div>
        </div>
    </div>