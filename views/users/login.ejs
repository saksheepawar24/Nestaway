<% layout("/layouts/boilerplate") %>

    <div class="form-container">
        <h2 class="form-heading">Login to NestAway</h2>

        <form method="POST" action="/login" class="listing-form needs-validation" novalidate>
            <div class="form-group">
                <label for="username">Username</label>
                <input id="username" name="username" type="text" class="form-control" placeholder="Enter your username"
                    required>
                <div class="invalid-feedback">Please enter your username.</div>
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input id="password" name="password" type="password" class="form-control"
                    placeholder="Enter your password" required>
                <div class="invalid-feedback">Please enter your password.</div>
            </div>

            <button id="login-submit" type="submit" class="submit-btn btn-success">Login</button>
        </form>
    </div>